FROM golang:1.24-alpine AS build
WORKDIR /src
COPY go.mod ./
COPY cmd/mock-receiver/ cmd/mock-receiver/
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /mock-receiver ./cmd/mock-receiver/

FROM gcr.io/distroless/static-debian12
COPY --from=build /mock-receiver /mock-receiver
USER 10001
EXPOSE 9999
ENTRYPOINT ["/mock-receiver"]
CMD ["--port", "9999"]
