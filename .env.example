# SWT3 Infrastructure Witness -- Environment Variables
# Copy to .env and fill in your values.
# Get your API key: https://sovereign.tenova.io/signup
#
# NEVER commit .env files. Use Secrets Manager / Key Vault for production.

# Required
SWT3_API_KEY=axm_live_YOUR_KEY_HERE

# Optional (defaults shown)
SWT3_ENDPOINT=https://sovereign.tenova.io/api/v1/witness/ocsf
SWT3_CLEARING_LEVEL=1
SWT3_AGENT_ID=swt3-infra-witness
SWT3_SIGNING_KEY=
